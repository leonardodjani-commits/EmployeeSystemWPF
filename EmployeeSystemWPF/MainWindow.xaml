<Window x:Class="EmployeeSystemWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee System"
        Height="750"
        Width="1200">

    <Grid>

        <Image Source="/images/logo.png"
               Width="500"
               Height="500"
               Opacity="0.08"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <DockPanel>

            <!-- Status Bar -->
            <Separator Background="Gray" Width="1" Margin="10,0"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusClockText"
               Text="🕐 00:00:00"
               Foreground="White"
               FontSize="12"/>
            </StatusBarItem>
            <StatusBar DockPanel.Dock="Bottom" Background="#212529" Height="30">
                <StatusBarItem>
                    <TextBlock x:Name="StatusEmployeesText"
                               Text="Employees: 0"
                               Foreground="White"
                               FontSize="12"/>
                </StatusBarItem>
                <Separator Background="Gray" Width="1" Margin="10,0"/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusFilterText"
                               Text="Showing: All"
                               Foreground="White"
                               FontSize="12"/>
                </StatusBarItem>
                <Separator Background="Gray" Width="1" Margin="10,0"/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusLastUpdatedText"
                               Text="Last updated: --:--"
                               Foreground="White"
                               FontSize="12"/>
                </StatusBarItem>
                <Separator Background="Gray" Width="1" Margin="10,0"/>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusSelectedText"
                               Text="Selected: None"
                               Foreground="#0d6efd"
                               FontWeight="Bold"
                               FontSize="12"/>
                </StatusBarItem>
            </StatusBar>

            <!-- Main Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <!-- Title + Theme Toggle -->
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock Text="Employee Management System"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>
                        <Button Content="ℹ️ About"
                                Width="90"
                                Height="35"
                                HorizontalAlignment="Right"
                                Margin="0,0,10,0"
                                Click="About_Click"/>
                        <Button x:Name="ThemeToggleButton"
                                Content="🌙 Dark Mode"
                                Width="130"
                                Height="35"
                                HorizontalAlignment="Right"
                                Click="ThemeToggle_Click"/>
                    </DockPanel>

                    <!-- Stats Cards -->
                    <WrapPanel Margin="0,0,0,20">
                        <Border Background="#212529" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Total Employees" Foreground="White"/>
                                <TextBlock x:Name="TotalEmployeesText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#6f42c1" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Departments" Foreground="White"/>
                                <TextBlock x:Name="TotalDepartmentsText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0d6efd" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Average Salary" Foreground="White"/>
                                <TextBlock x:Name="AverageSalaryText" Text="$0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#198754" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Max Salary" Foreground="White"/>
                                <TextBlock x:Name="MaxSalaryText" Text="$0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#dc3545" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Min Salary" Foreground="White"/>
                                <TextBlock x:Name="MinSalaryText" Text="$0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Controls Row 1 -->
                    <WrapPanel Margin="0,0,0,10">

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="First Name" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBox x:Name="FirstNameTextBox" Width="140" Height="30" ToolTip="First Name"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Last Name" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBox x:Name="LastNameTextBox" Width="140" Height="30" ToolTip="Last Name"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Salary" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBox x:Name="SalaryTextBox" Width="100" Height="30" ToolTip="Salary"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Department" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <ComboBox x:Name="DepartmentComboBox"
                                      Width="180" Height="30"
                                      DisplayMemberPath="DepartmentName"
                                      SelectedValuePath="DepartmentId"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Email" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBox x:Name="EmailTextBox" Width="180" Height="30" ToolTip="Email"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Phone" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBox x:Name="PhoneTextBox" Width="140" Height="30" ToolTip="Phone"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Hire Date" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <DatePicker x:Name="HireDatePicker" Width="150" Height="30"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="➕ Add Employee" Width="140" Height="30" Click="AddEmployee_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="✏ Edit Selected" Width="140" Height="30" Click="EditEmployee_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="💾 Update Employee" Width="160" Height="30" Click="UpdateEmployee_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="❌ Delete Selected" Width="150" Height="30" Click="DeleteEmployee_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="🖼 Choose Photo" Width="140" Height="30" Click="ChoosePhoto_Click"/>
                        </StackPanel>

                    </WrapPanel>

                    <!-- Controls Row 2 - Search and Filter -->
                    <WrapPanel Margin="0,0,0,15">

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Search" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBox x:Name="SearchTextBox" Width="200" Height="30" ToolTip="Search employee"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="🔍 Search" Width="100" Height="30" Click="SearchEmployee_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Filter by Department" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <ComboBox x:Name="FilterDepartmentComboBox"
                                      Width="180" Height="30"
                                      DisplayMemberPath="DepartmentName"
                                      SelectedValuePath="DepartmentId"
                                      SelectionChanged="FilterByDepartment_Changed"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="🔄 Clear Filter" Width="120" Height="30" Click="ClearFilter_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="🔄 Load Employees" Width="140" Height="30" Click="LoadEmployees_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="📊 Export to Excel" Width="150" Height="30" Click="ExportToExcel_Click"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,2"/>
                            <Button Content="📄 Export to PDF" Width="150" Height="30" Click="ExportToPDF_Click"/>
                        </StackPanel>

                    </WrapPanel>

                    <!-- Data Grid -->
                    <DataGrid x:Name="EmployeesGrid"
                              AutoGenerateColumns="False"
                              Height="380"
                              RowHeight="70"
                              CanUserSortColumns="True"
                              SelectionChanged="EmployeesGrid_SelectionChanged"
                              MouseDoubleClick="EmployeesGrid_DoubleClick">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#e8f4fd"/>
                                        <Setter Property="Foreground" Value="#1a1a2e"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0d6efd"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip>
                                            <StackPanel Margin="5">
                                                <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,5">
                                                    <Run Text="{Binding FirstName, TargetNullValue=''}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding LastName, TargetNullValue=''}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="🆔 ID: " FontWeight="Bold"/>
                                                    <Run Text="{Binding EmployeeId}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="🏢 Department: " FontWeight="Bold"/>
                                                    <Run Text="{Binding Department, TargetNullValue='N/A'}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="💰 Salary: $" FontWeight="Bold"/>
                                                    <Run Text="{Binding Salary}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="📧 Email: " FontWeight="Bold"/>
                                                    <Run Text="{Binding Email, TargetNullValue='N/A'}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="📞 Phone: " FontWeight="Bold"/>
                                                    <Run Text="{Binding Phone, TargetNullValue='N/A'}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="📅 Hire Date: " FontWeight="Bold"/>
                                                    <Run Text="{Binding HireDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='N/A'}"/>
                                                </TextBlock>
                                                <TextBlock>
    <Run Text="⏳ Years of Service: " FontWeight="Bold"/>
    <Run Text="{Binding YearsOfService, Mode=OneWay, TargetNullValue='N/A'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding EmployeeId}"
                                                SortMemberPath="EmployeeId"/>

                            <DataGridTextColumn Header="First Name"
                                                Binding="{Binding FirstName}"
                                                SortMemberPath="FirstName"/>

                            <DataGridTextColumn Header="Last Name"
                                                Binding="{Binding LastName}"
                                                SortMemberPath="LastName"/>

                            <DataGridTextColumn Header="Salary"
                                                Binding="{Binding Salary}"
                                                SortMemberPath="Salary"/>

                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding Department}"
                                                SortMemberPath="Department"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                SortMemberPath="Email"/>

                            <DataGridTextColumn Header="Phone"
                                                Binding="{Binding Phone}"
                                                SortMemberPath="Phone"/>

                            <DataGridTextColumn Header="Hire Date"
                                                Binding="{Binding HireDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                SortMemberPath="HireDate"/>

                            <DataGridTextColumn Header="Years of Service"
                    Binding="{Binding YearsOfService, Mode=OneWay}"
                    SortMemberPath="HireDate"/>

                            <DataGridTemplateColumn Header="Photo" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="50" Height="50">
                                            <Ellipse Width="46" Height="46"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#6f42c1" Offset="0"/>
                                                        <GradientStop Color="#0d6efd" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <TextBlock Text="{Binding Initials}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <Ellipse Width="46" Height="46"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Photo}"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>

    </Grid>
</Window>