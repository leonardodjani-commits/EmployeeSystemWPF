<Window x:Class="EmployeeSystemWPF.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="400"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border CornerRadius="15" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- Top colored bar -->
            <Border CornerRadius="15,15,0,0"
                    Height="140"
                    VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0d6efd" Offset="0"/>
                        <GradientStop Color="#6f42c1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/images/logo.png"
                           Width="60" Height="60"
                           Margin="0,0,0,8"/>
                    <TextBlock Text="Employee Management System"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Close button -->
            <Button Content="✕"
                    Width="30" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>

            <!-- Content -->
            <StackPanel Margin="40,155,40,0" VerticalAlignment="Top">

                <TextBlock Text="Version 1.0.0"
                           FontSize="13"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Separator Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="👨‍💻  Developer: "
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#212529"/>
                    <TextBlock Text="Pedro Ngoi"
                               FontSize="13"
                               Foreground="#0d6efd"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="🛠️  Technology: "
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#212529"/>
                    <TextBlock Text="WPF / C# / MySQL"
                               FontSize="13"
                               Foreground="Gray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📅  Year: "
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#212529"/>
                    <TextBlock Text="2026"
                               FontSize="13"
                               Foreground="Gray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="📧  Contact: "
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#212529"/>
                    <TextBlock Text="pedro@email.com"
                               FontSize="13"
                               Foreground="#0d6efd"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Content="Close"
                        Height="40"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0d6efd" Offset="0"/>
                            <GradientStop Color="#6f42c1" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

        </Grid>
    </Border>
</Window>