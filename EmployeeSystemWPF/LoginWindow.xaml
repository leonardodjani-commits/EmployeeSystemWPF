<Window x:Class="EmployeeSystemWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Height="500"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border CornerRadius="15" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- Top colored bar -->
            <Border CornerRadius="15,15,0,0"
                    Height="160"
                    VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0d6efd" Offset="0"/>
                        <GradientStop Color="#6f42c1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="/images/logo.png"
                           Width="70"
                           Height="70"
                           Margin="0,0,0,8"/>
                    <TextBlock Text="Employee System"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Close button -->
            <Button Content="✕"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>

            <!-- Form -->
            <StackPanel Margin="40,180,40,0"
                        VerticalAlignment="Top">

                <TextBlock Text="Welcome back 👋"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#212529"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Sign in to continue"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,25"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,0,0,4"/>
                <Border BorderBrush="#dee2e6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,15">
                    <TextBox x:Name="UsernameTextBox"
                             Height="38"
                             BorderThickness="0"
                             Padding="10,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Background="Transparent"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,0,0,4"/>
                <Border BorderBrush="#dee2e6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,25">
                    <PasswordBox x:Name="PasswordBox"
                                 Height="38"
                                 BorderThickness="0"
                                 Padding="10,0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 KeyDown="PasswordBox_KeyDown"/>
                </Border>

                <!-- Error message -->
                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#dc3545"
                           FontSize="12"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton"
                        Content="Sign In"
                        Height="42"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0d6efd" Offset="0"/>
                            <GradientStop Color="#6f42c1" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

        </Grid>
    </Border>
</Window>